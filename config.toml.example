# Serial Fork configuration file
# Copy to config.toml and fill in values.
# Secrets (tokens, keys) should be set via environment variables instead.

# Discord bot
discord_guild_id = 1234567687
discord_request_channel_id = 123456789
discord_mod_notify_channel_id = 123456789
discord_client_id = "12345679"

# Web app
web_base_url = "http://localhost:8000"
web_host = "0.0.0.0"
web_port = 8000

# Database
db_path = "/data/serial_fork.db"

# Serial display
# serial_prefix is no longer used — each printer type has its own identifier.
# serial_pad_width controls minimum digit width (3 → BBP-001, auto-expands beyond 999)
# serial_delimiter is the character between the type identifier and number (default "-" → BBP-001)
serial_pad_width = 3
# serial_delimiter = "-"

# Bootstrap: auto-create the first Owner on startup (ignored once an owner exists).
# Recommended: set INITIAL_OWNER_DISCORD_ID as an environment variable instead.
# initial_owner_discord_id = "123456789012345678"
# initial_owner_username = "YourName"   # optional, defaults to "Owner"

# Housekeeping: auto-purge rejected requests after N days (0 = disabled)
rejected_request_purge_days = 30

# Dev flags (set to false in production)
sync_commands = false
debug = false
