# BB-Serial environment variables
# Copy to .env and fill in secrets. NEVER commit .env to version control.

# Discord bot token (from Discord Developer Portal)
DISCORD_TOKEN=your-bot-token-here

# Discord OAuth2 secret (from Discord Developer Portal)
DISCORD_CLIENT_SECRET=your-client-secret-here

# Web session secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
WEB_SECRET_KEY=generate-a-random-secret-here

# First Owner bootstrap — set your Discord user ID here on first deploy.
# The owner account is created automatically on startup if none exists yet.
# Safe to leave set permanently; it's a no-op once an owner is in the database.
# INITIAL_OWNER_DISCORD_ID=123456789012345678
# INITIAL_OWNER_USERNAME=YourName

# Optional: override config.toml values via env vars
# DISCORD_GUILD_ID=123456789012345678
# DB_PATH=/data/bb_serial.db
# WEB_BASE_URL is pinned to http://localhost:8000 for local dev via
# docker-compose.override.yml — only set it here for production deployments.
# WEB_BASE_URL=https://serials.yourdomain.com
# WEB_PORT=8000
# DEBUG=false
# SYNC_COMMANDS=false
